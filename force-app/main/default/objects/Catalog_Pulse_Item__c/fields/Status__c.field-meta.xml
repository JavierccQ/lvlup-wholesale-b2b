    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>ACTIVE</fullName>
                <default>true</default>
                <label>Active</label>
            </value>
            <value>
                <fullName>EXPIRED</fullName>
                <default>false</default>
                <label>Expired</label>
            </value>
            <value>
                <fullName>HIDDEN</fullName>
                <default>false</default>
                <label>Hidden</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
