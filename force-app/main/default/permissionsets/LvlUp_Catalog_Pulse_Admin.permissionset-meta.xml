<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>LvlUp Catalog Pulse Admin</label>
    <description
  >Full management of the Catalog Pulse Item feed (create/read/edit/delete and field edit) for admins/operators who curate or manually adjust novelties, plus access to the Catalog Pulse controller for testing.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>LvlupCatalogPulseController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <objectPermissions>
        <object>Catalog_Pulse_Item__c</object>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Catalog_Pulse_Item__c.Change_Type__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Catalog_Pulse_Item__c.Effective_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Catalog_Pulse_Item__c.Expiration_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Catalog_Pulse_Item__c.Message__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Catalog_Pulse_Item__c.Priority__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Catalog_Pulse_Item__c.Product_Code__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Catalog_Pulse_Item__c.Product__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Catalog_Pulse_Item__c.Segment_Key__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Catalog_Pulse_Item__c.Source_Object__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Catalog_Pulse_Item__c.Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Catalog_Pulse_Item__c.Title__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Catalog_Pulse_Item__c.Pulse_Key__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
